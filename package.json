{
  "name": "obsidian-langdock-sync",
  "version": "0.1.0",
  "private": true,
  "description": "Sync Obsidian notes with Langdock.",
  "license": "MIT",
  "repository": "github:nblum/obsidian-langdock-sync",
  "main": "main.js",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "build": "npm run validate:manifest && npm run typecheck && node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.mjs",
    "test:e2e": "npm run build && node scripts/run-obsidian-tests.mjs",
    "screenshots": "npm run build && node scripts/run-obsidian-tests.mjs --screenshots",
    "screenshots:update": "npm run screenshots && node scripts/update-screenshots.mjs",
    "validate:manifest": "node scripts/release-metadata.mjs check",
    "release:prepare": "node scripts/release-metadata.mjs prepare"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/mocha": "10.0.10",
    "@types/node": "24.19.2",
    "@wdio/cli": "10.2.0",
    "@wdio/globals": "10.2.0",
    "@wdio/local-runner": "10.2.0",
    "@wdio/mocha-framework": "10.2.0",
    "@wdio/spec-reporter": "10.2.0",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "globals": "17.11.0",
    "obsidian": "1.14.4",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "wdio-obsidian-service": "3.5.0"
  },
  "dependencies": {
    "yaml": "2.9.1"
  }
}
